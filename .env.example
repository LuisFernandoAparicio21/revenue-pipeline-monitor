# === APLICACIÓN ===
APP_ENV=development
APP_SECRET_KEY=cambia_esto_por_32_bytes_random
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# === BASE DE DATOS ===
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/revenue_pipeline
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# === REDIS ===
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_MAX_CONNECTIONS=20
IDEMPOTENCY_TTL_SECONDS=86400

# === CELERY ===
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_MAX_RETRIES=5
CELERY_TASK_DEFAULT_RETRY_DELAY=60

# === STRIPE ===
STRIPE_SECRET_KEY=sk_test_pon_tu_key_aqui
STRIPE_WEBHOOK_SECRET=whsec_pon_tu_secret_aqui
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
STRIPE_API_VERSION=2023-10-16

# === HUBSPOT OAuth ===
HUBSPOT_CLIENT_ID=pon_tu_client_id
HUBSPOT_CLIENT_SECRET=pon_tu_client_secret
HUBSPOT_REDIRECT_URI=http://localhost:8000/api/v1/oauth/hubspot/callback
HUBSPOT_SCOPES=crm.objects.contacts.write crm.objects.deals.write oauth

# === HUBSPOT Configuración ===
HUBSPOT_API_BASE_URL=https://api.hubapi.com
HUBSPOT_REQUESTS_PER_SECOND=10
HUBSPOT_DAILY_LIMIT=250000
HUBSPOT_DEAL_PIPELINE_ID=default
HUBSPOT_DEAL_STAGE_NEW=appointmentscheduled
HUBSPOT_DEAL_STAGE_PAID=closedwon
HUBSPOT_DEAL_STAGE_CHURNED=closedlost

# === ANTHROPIC / LLM ===
ANTHROPIC_API_KEY=sk-ant-pon_tu_key_aqui
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=1024
LLM_ENRICHMENT_ENABLED=true
LLM_CACHE_TTL_DAYS=30

# === SEGURIDAD ===
ENCRYPTION_KEY=genera_con_python_Fernet_generate_key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# === HTTP CLIENT ===
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3
HTTP_RETRY_BACKOFF_FACTOR=2.0

# === MONITORING (opcional) ===
SENTRY_DSN=
